{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "outDir": "./dist",
    "baseUrl": "./",
    "paths": {
      "@domain/*": ["./src/domain/*"],
      "@application/*": ["./src/application/*"],
      "@infra/*": ["./src/infra/*"],
      "@services/*": ["./src/application/services/*"],
      "@test/*": ["./test/*"],
      "@tokens/*": ["./src/tokens.ts"],
    },
  },
  "include": ["src", "test"],
}
