# Global
NODE_ENV=development

# RabbitMQ
RABBITMQ_URL=amqp://guest:guest@localhost:5672
RABBITMQ_EXCHANGE=food-ordering

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# PostgreSQL — set to 'postgres' to enable, omit for in-memory
DB_DRIVER=postgres

# Order Service
ORDER_PORT=3001
ORDER_DATABASE_URL=postgres://postgres:postgres@localhost:5432/orders

# Kitchen Service
KITCHEN_PORT=3002
KITCHEN_DATABASE_URL=postgres://postgres:postgres@localhost:5434/kitchen

# Payment Service
PAYMENT_PORT=3003
PAYMENT_DATABASE_URL=postgres://postgres:postgres@localhost:5433/payments

# Notification Service
NOTIFICATION_PORT=3004

# Analytics Service
ANALYTICS_PORT=3005

# Customer Service
CUSTOMER_PORT=3006
CUSTOMER_DATABASE_URL=postgres://postgres:postgres@localhost:5436/customers

# Restaurant Service
RESTAURANT_PORT=3007
RESTAURANT_DATABASE_URL=postgres://postgres:postgres@localhost:5437/restaurants

# Auth Service
AUTH_PORT=3008
AUTH_DATABASE_URL=postgres://postgres:postgres@localhost:5438/auth

# Cart Service
CART_PORT=3009
CART_DATABASE_URL=postgres://postgres:postgres@localhost:5439/carts
RESTAURANT_SERVICE_URL=http://localhost:3007
REDIS_CACHE_TTL_SECONDS=300

# tRPC Client Configuration
TRPC_CLIENT_TIMEOUT_MS=5000
